{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Expense Lens",
  "version": "0.2.0",
  "identifier": "com.expenselens.local",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Expense Lens",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dataDirectory": "ExpenseLensWebView"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "category": "Finance",
    "shortDescription": "本地优先的个人收支分析工具",
    "longDescription": "在本机导入、整理和分析微信支付与支付宝账单。"
  }
}
